download_file(){
  local output=$1
  shift
  local url
  local attempt
  for url in "$@"; do
    for attempt in 1 2 3; do
      if curl -fsSL --connect-timeout 8 --max-time "${DOWNLOAD_MAX_TIME:-120}" "$url" -o "$output"; then
        return 0
      fi
      rm -f "$output"
      sleep 2
    done
  done
  return 1
}

fetch_text(){
  local url
  local attempt
  for url in "$@"; do
    for attempt in 1 2 3; do
      if curl -fsSL --connect-timeout 8 --max-time "${DOWNLOAD_MAX_TIME:-120}" "$url"; then
        return 0
      fi
      sleep 2
    done
  done
  return 1
}

github_raw(){
  local path=$1
  fetch_text \
    "https://ghproxy.net/https://raw.githubusercontent.com/$path" \
    "https://raw.githubusercontent.com/$path"
}

github_download(){
  local output=$1
  local path=$2
  download_file "$output" \
    "https://ghproxy.net/https://raw.githubusercontent.com/$path" \
    "https://raw.githubusercontent.com/$path"
}

