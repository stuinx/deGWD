    if [[ $WGCFswitch == "1" || $WGCFswitch == "2" ]]; then
      local mode="ipv4"
      [[ $WGCFswitch == "2" ]] && mode="dual"

      if [[ ${DE_GWD_TEST_MODE:-0} != 1 ]]; then
        unset aptPKG
