    elif [[ $WGCFswitch == "4" ]]; then
      if [[ $(jq -r '.enabled // false' "$DE_GWD_WARP_SETTINGS" 2>/dev/null) = "true" ]] || systemctl is-active --quiet wg-quick@wgcf 2>/dev/null; then
        echo -e "${GREEN}WARP is active.${cRES}"
