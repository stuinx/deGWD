        curIPv6=$(curl -6sSL --connect-timeout 3 ifconfig.me 2>/dev/null || true)
        [[ -n $curIPv4 ]] && echo -e "Outbound IPv4: ${YELLOW}$curIPv4${cRES}"
        [[ -n $curIPv6 ]] && echo -e "Outbound IPv6: ${YELLOW}$curIPv6${cRES}"
      else
        echo -e "${YELLOW}WARP is not active.${cRES}"
      fi
    fi
}

socks5_egress_valid_server(){
  [[ $1 =~ ^[A-Za-z0-9.-]+$ || $1 =~ ^[0-9a-fA-F:]+$ ]]
}

socks5_egress_valid_port(){
  [[ $1 =~ ^[1-9][0-9]{0,4}$ ]] && (( $1 <= 65535 ))
}

socks5_egress_render_scripts(){
  local server=$1
  local port=$2
  mkdir -p -- "$(dirname -- "$DE_GWD_SOCKS5_POSTUP")" "$(dirname -- "$DE_GWD_SOCKS5_POSTDOWN")" || return 1

  cat << 'EOF_POSTUP' > "$DE_GWD_SOCKS5_POSTUP"
#!/bin/bash
localAddrIPv4=$(ip -4 a 2>/dev/null | grep inet | grep -v '127.0.0.1' | awk '{print $2}' | cut -d'/' -f1 | head -n 1)
sshPort=$(ss -tlpn 2>/dev/null | grep -E 'sshd|ssh' | awk '{print $4}' | awk -F':' '{print $NF}' | head -n 1)
[[ -z $sshPort ]] && sshPort=$(grep -E '^Port ' /etc/ssh/sshd_config 2>/dev/null | awk '{print $2}' | head -n 1)
sshPort=${sshPort:-22}

ip link set dev tun-socks up 2>/dev/null || true
ip route add default dev tun-socks table 51830 2>/dev/null || true

[[ -n $localAddrIPv4 ]] && ip rule add from "$localAddrIPv4" lookup main priority 51831 2>/dev/null || true

if [[ -n $sshPort ]]; then
  ip rule add sport "$sshPort" lookup main priority 51832 2>/dev/null || true
  ip rule add dport "$sshPort" lookup main priority 51832 2>/dev/null || true
fi

ip rule add to 127.0.0.0/8 lookup main priority 51833 2>/dev/null || true
ip rule add to 10.0.0.0/8 lookup main priority 51833 2>/dev/null || true
ip rule add to 172.16.0.0/12 lookup main priority 51833 2>/dev/null || true
ip rule add to 192.168.0.0/16 lookup main priority 51833 2>/dev/null || true

ip rule add ipproto udp dport 53 lookup main priority 51834 2>/dev/null || true
ip rule add ipproto tcp dport 53 lookup main priority 51834 2>/dev/null || true
ip rule add ipproto tcp dport 853 lookup main priority 51834 2>/dev/null || true
EOF_POSTUP

  if [[ -n $server ]]; then
    cat << EOF_SRV >> "$DE_GWD_SOCKS5_POSTUP"
for srv_ip in \$(getent ahosts "$server" 2>/dev/null | awk '{print \$1}' | sort -u); do
  [[ \$srv_ip =~ ^[0-9.]+\$ ]] && ip rule add to "\$srv_ip" lookup main priority 51835 2>/dev/null || true
done
EOF_SRV
  fi

  cat << 'EOF_POSTUP_TAIL' >> "$DE_GWD_SOCKS5_POSTUP"
ip rule add ipproto tcp lookup 51830 priority 51839 2>/dev/null || true
EOF_POSTUP_TAIL

  chmod +x "$DE_GWD_SOCKS5_POSTUP" || return 1

  cat << 'EOF_POSTDOWN' > "$DE_GWD_SOCKS5_POSTDOWN"
#!/bin/bash
ip rule del priority 51831 2>/dev/null || true
ip rule del priority 51832 2>/dev/null || true
ip rule del priority 51832 2>/dev/null || true
ip rule del priority 51833 2>/dev/null || true
ip rule del priority 51833 2>/dev/null || true
ip rule del priority 51833 2>/dev/null || true
ip rule del priority 51833 2>/dev/null || true
ip rule del priority 51834 2>/dev/null || true
ip rule del priority 51834 2>/dev/null || true
ip rule del priority 51834 2>/dev/null || true
ip rule del priority 51835 2>/dev/null || true
ip rule del priority 51839 2>/dev/null || true

ip route flush table 51830 2>/dev/null || true
EOF_POSTDOWN

  chmod +x "$DE_GWD_SOCKS5_POSTDOWN" || return 1
}

socks5_egress_render_service(){
  local server=$1
  local port=$2
  local user=$3
  local pass=$4
  local proxyUrl
  if [[ -n $user ]]; then
    proxyUrl="socks5://$user:$pass@$server:$port"
  else
    proxyUrl="socks5://$server:$port"
  fi

  mkdir -p -- "$(dirname -- "$DE_GWD_SOCKS5_EGRESS_SERVICE")" || return 1
  cat << EOF_SERVICE > "$DE_GWD_SOCKS5_EGRESS_SERVICE"
[Unit]
Description=de_GWD System SOCKS5 Upstream Egress
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=-/sbin/ip link del dev tun-socks
ExecStart=$DE_GWD_TUN2SOCKS_BIN -device tun-socks -proxy $proxyUrl
ExecStartPost=$DE_GWD_SOCKS5_POSTUP
ExecStopPost=$DE_GWD_SOCKS5_POSTDOWN
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF_SERVICE
}

socks5_egress_test_connectivity(){
  local server=$1
  local port=$2
  local user=${3:-}
  local pass=${4:-}
  if [[ ${DE_GWD_TEST_MODE:-0} == 1 ]]; then
    return "${FAKE_SOCKS5_EGRESS_FAIL:-0}"
  fi
  local authArg=""
  [[ -n $user ]] && authArg="$user:$pass@"
  curl -4 -sSL --connect-timeout 4 --max-time 6 --socks5 "${authArg}${server}:${port}" https://cloudflare.com/cdn-cgi/trace >/dev/null 2>&1
}

socks5_egress_stop(){
  systemctl stop de_GWD-socks5-egress >/dev/null 2>&1 || true
  systemctl disable de_GWD-socks5-egress >/dev/null 2>&1 || true
  if [[ -x $DE_GWD_SOCKS5_POSTDOWN ]]; then
    "$DE_GWD_SOCKS5_POSTDOWN" >/dev/null 2>&1 || true
  fi
  mkdir -p -- "$(dirname -- "$DE_GWD_SOCKS5_EGRESS_SETTINGS")" 2>/dev/null || true
  if [[ -f $DE_GWD_SOCKS5_EGRESS_SETTINGS ]]; then
    local tmp
    tmp=$(mktemp "${DE_GWD_SOCKS5_EGRESS_SETTINGS}.tmp.XXXXXX") 2>/dev/null || return 0
    jq '.enabled = false' "$DE_GWD_SOCKS5_EGRESS_SETTINGS" > "$tmp" 2>/dev/null && mv -f "$tmp" "$DE_GWD_SOCKS5_EGRESS_SETTINGS" || rm -f "$tmp"
  else
    printf '{"enabled":false}\n' > "$DE_GWD_SOCKS5_EGRESS_SETTINGS" 2>/dev/null || true
  fi
}

socks5_egress_start(){
  local server=$1
  local port=$2
  local user=${3:-}
  local pass=${4:-}

  socks5_egress_valid_server "$server" || return 1
  socks5_egress_valid_port "$port" || return 1

  if ! socks5_egress_test_connectivity "$server" "$port" "$user" "$pass"; then
    echo -e "${RED}Failed to reach SOCKS5 upstream $server:$port! Connection test failed.${cRES}"
    return 1
  fi

  socks5_egress_render_scripts "$server" "$port" || return 1
  socks5_egress_render_service "$server" "$port" "$user" "$pass" || return 1

  systemctl daemon-reload >/dev/null 2>&1 || true
  systemctl enable de_GWD-socks5-egress >/dev/null 2>&1 || true
  if ! systemctl restart de_GWD-socks5-egress >/dev/null 2>&1; then
    socks5_egress_stop
    return 1
  fi

  mkdir -p -- "$(dirname -- "$DE_GWD_SOCKS5_EGRESS_SETTINGS")" || return 1
  local tmpCfg
  tmpCfg=$(mktemp "${DE_GWD_SOCKS5_EGRESS_SETTINGS}.tmp.XXXXXX") || return 1
  jq -cn \
    --arg srv "$server" \
    --argjson port "$port" \
    --arg usr "$user" \
    --arg pwd "$pass" \
    '{enabled:true, server:$srv, port:$port, user:$usr, password:$pwd}' > "$tmpCfg" || { rm -f "$tmpCfg"; return 1; }
  chmod 0600 "$tmpCfg"
  mv -f -- "$tmpCfg" "$DE_GWD_SOCKS5_EGRESS_SETTINGS" || return 1
  return 0
}

changeSocks5Egress(){
  echo -e "${GREEN}=================================================== ${cRES}"
  echo -e "${GREEN}[1]: Enable System SOCKS5 Upstream Egress ${cRES}"
  echo -e "${GREEN}[2]: Disable System SOCKS5 Upstream Egress ${cRES}"
  echo -e "${GREEN}[3]: Check System SOCKS5 Upstream Egress Status ${cRES}"
  echo -e "${GREEN}=================================================== ${cRES}"
  read -r -p "Select [1-3]: " socksSwitch

  if [[ $socksSwitch == "1" ]]; then
    local oldServer oldPort oldUser oldPass
    if [[ -f $DE_GWD_SOCKS5_EGRESS_SETTINGS ]]; then
      oldServer=$(jq -r '.server // empty' "$DE_GWD_SOCKS5_EGRESS_SETTINGS" 2>/dev/null)
      oldPort=$(jq -r '.port // empty' "$DE_GWD_SOCKS5_EGRESS_SETTINGS" 2>/dev/null)
      oldUser=$(jq -r '.user // empty' "$DE_GWD_SOCKS5_EGRESS_SETTINGS" 2>/dev/null)
      oldPass=$(jq -r '.password // empty' "$DE_GWD_SOCKS5_EGRESS_SETTINGS" 2>/dev/null)
    fi

    read -r -p "SOCKS5 server host/IP [${oldServer:-127.0.0.1}]: " inServer
    inServer=${inServer:-${oldServer:-127.0.0.1}}
    socks5_egress_valid_server "$inServer" || { echo -e "${RED}Invalid SOCKS5 server address${cRES}"; return 1; }

    read -r -p "SOCKS5 port [${oldPort:-1080}]: " inPort
    inPort=${inPort:-${oldPort:-1080}}
    socks5_egress_valid_port "$inPort" || { echo -e "${RED}Invalid SOCKS5 port (1-65535)${cRES}"; return 1; }

    read -r -p "SOCKS5 username (optional) [${oldUser:-}]: " inUser
    inUser=${inUser:-${oldUser:-}}

    read -r -s -p "SOCKS5 password (optional): " inPass
    echo
    inPass=${inPass:-${oldPass:-}}

    echo -e "${WHITE}[...${WHITE}]\c" && echo -e "\t${WHITE}Connecting and verifying SOCKS5 upstream egress...${cRES}\r\c"
    if socks5_egress_start "$inServer" "$inPort" "$inUser" "$inPass"; then
      echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}System SOCKS5 Upstream Egress ${GREEN}Enabled${cRES}"
    else
      echo -e "${WHITE}[ ${RED}✕ ${WHITE}]\c" && echo -e "\t${WHITE}System SOCKS5 Upstream Egress ${RED}Failed & Rolled Back${cRES}"
    fi
  elif [[ $socksSwitch == "2" ]]; then
    socks5_egress_stop
    echo -e "${WHITE}[ ${RED}✕ ${WHITE}]\c" && echo -e "\t${WHITE}System SOCKS5 Upstream Egress ${RED}Disabled${cRES}"
  elif [[ $socksSwitch == "3" ]]; then
    if [[ $(jq -r '.enabled // false' "$DE_GWD_SOCKS5_EGRESS_SETTINGS" 2>/dev/null) = "true" ]] || systemctl is-active --quiet de_GWD-socks5-egress 2>/dev/null; then
      local srv port
      srv=$(jq -r '.server // empty' "$DE_GWD_SOCKS5_EGRESS_SETTINGS" 2>/dev/null)
      port=$(jq -r '.port // empty' "$DE_GWD_SOCKS5_EGRESS_SETTINGS" 2>/dev/null)
      echo -e "${GREEN}System SOCKS5 Egress is active via $srv:$port.${cRES}"
      local outIP
      outIP=$(curl -4sSL --connect-timeout 3 ifconfig.me 2>/dev/null || true)
      [[ -n $outIP ]] && echo -e "Current Outbound IP: ${YELLOW}$outIP${cRES}"
    else
      echo -e "${YELLOW}System SOCKS5 Egress is disabled.${cRES}"
    fi
  fi
}



RproxyS_valid_uuid(){
[[ $1 =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]]
}


RproxyS_valid_port(){
[[ $1 =~ ^[1-9][0-9]{0,4}$ ]] && (( $1 <= 65535 ))
}


RproxySsave(){
local settings=/opt/de_GWD/RproxyS/settings.json
local runtime=/opt/de_GWD/RproxyS
local binary=/opt/de_GWD/vtrui/vtrui
local tunnelPort tunnelUUID enabled clients mappingList len i uuid mappingPort mappingProtocol
local configTmp configNext serviceTmp
local mappingPorts=""

[[ -f $settings ]] || return 1
if ! jq -e . "$settings" >/dev/null 2>&1; then
  echo -e "${WHITE}RproxyS settings${RED} Invalid JSON${cRES}"
  return 1
fi

enabled=$(jq -r 'if .enabled == false then "false" else "true" end' "$settings") || return 1
[[ $enabled = "false" ]] && return 0
[[ -x $binary ]] || { echo -e "${WHITE}RproxyS${RED} requires Xray binary${cRES}"; return 1; }

tunnelPort=$(jq -r '.port // empty' "$settings")
tunnelUUID=$(jq -r '.uuid // empty' "$settings")
RproxyS_valid_port "$tunnelPort" || { echo -e "${WHITE}RproxyS${RED} invalid tunnel port${cRES}"; return 1; }
RproxyS_valid_uuid "$tunnelUUID" || { echo -e "${WHITE}RproxyS${RED} invalid tunnel UUID${cRES}"; return 1; }

if ! jq -e '(.clients // []) | type == "array"' "$settings" >/dev/null 2>&1 ||
   ! jq -e '(.mapping // []) | type == "array"' "$settings" >/dev/null 2>&1; then
  echo -e "${WHITE}RproxyS settings${RED} clients/mapping must be arrays${cRES}"
  return 1
fi

clients=$(jq -r '(.clients // []) | unique[]? // empty' "$settings") || return 1
while IFS= read -r uuid; do
  [[ -z $uuid ]] && continue
  RproxyS_valid_uuid "$uuid" || { echo -e "${WHITE}RproxyS${RED} invalid client UUID${cRES}"; return 1; }
done <<< "$clients"

mappingList=$(jq -c '.mapping // []' "$settings") || return 1
len=$(jq length <<< "$mappingList") || return 1
for (( i=0; i<len; i++ )); do
  mappingPort=$(jq -r --argjson i "$i" '.[$i].port // empty' <<< "$mappingList")
  mappingProtocol=$(jq -r --argjson i "$i" '.[$i].protocol // empty' <<< "$mappingList")
  RproxyS_valid_port "$mappingPort" || { echo -e "${WHITE}RproxyS${RED} invalid mapping port${cRES}"; return 1; }
  [[ $mappingPort != "$tunnelPort" ]] || { echo -e "${WHITE}RproxyS${RED} mapping port conflicts with tunnel port${cRES}"; return 1; }
  [[ $mappingProtocol = "tcp" || $mappingProtocol = "udp" || $mappingProtocol = "tcp,udp" ]] || {
    echo -e "${WHITE}RproxyS${RED} invalid mapping protocol${cRES}"
    return 1
  }
  [[ ",${mappingPorts}," = *",${mappingPort},"* ]] && {
    echo -e "${WHITE}RproxyS${RED} duplicate mapping port${cRES}"
    return 1
  }
  mappingPorts="${mappingPorts},${mappingPort}"
done

configTmp=$(mktemp /tmp/de_GWD-RproxyS-config.XXXXXX.json) || return 1
configNext="${configTmp}.next"
if ! jq -n --argjson port "$tunnelPort" --arg uuid "$tunnelUUID" '
{
  "log":{"access":"none","error":"none","loglevel":"none"},
  "dns":{"queryStrategy":"UseIP","disableCache":true,"servers":["tcp+local://127.0.0.1:53"]},
  "routing":{"rules":[
    {"type":"field","inboundTag":["reverseTunnel"],"domain":["full:reverse.localhost"],"outboundTag":"portal"},
    {"type":"field","inboundTag":["reverseTunnel"],"outboundTag":"portal"}
  ]},
  "reverse":{"portals":[{"tag":"portal","domain":"reverse.localhost"}]},
  "inbounds":[{
    "tag":"reverseTunnel",
    "port":$port,
    "protocol":"vmess",
    "settings":{"clients":[{"id":$uuid,"alterId":0}]},
    "streamSettings":{"network":"tcp"}
  }]
}' >"$configTmp"; then
  rm -f "$configTmp" "$configNext"
  return 1
fi

while IFS= read -r uuid; do
  [[ -z $uuid || $uuid = "$tunnelUUID" ]] && continue
  if ! jq --arg id "$uuid" '.inbounds[0].settings.clients += [{"id":$id,"alterId":0}]' "$configTmp" >"$configNext" ||
     ! mv -f "$configNext" "$configTmp"; then
    rm -f "$configTmp" "$configNext"
    return 1
  fi
done <<< "$clients"

for (( i=0; i<len; i++ )); do
  mappingPort=$(jq -r --argjson i "$i" '.[$i].port' <<< "$mappingList")
  mappingProtocol=$(jq -r --argjson i "$i" '.[$i].protocol' <<< "$mappingList")
  if ! jq --argjson port "$mappingPort" --arg protocol "$mappingProtocol" --arg tag "mapping$i" '
    .routing.rules += [{"type":"field","inboundTag":[$tag],"outboundTag":"portal"}]
    | .inbounds += [{"tag":$tag,"port":$port,"protocol":"dokodemo-door","settings":{"address":"127.0.0.1","port":$port,"network":$protocol}}]
  ' "$configTmp" >"$configNext"; then
    rm -f "$configTmp" "$configNext"
    return 1
  fi
  mv -f "$configNext" "$configTmp" || {
    rm -f "$configTmp" "$configNext"
    return 1
  }
done

jq -e . "$configTmp" >/dev/null 2>&1 || {
  rm -f "$configTmp" "$configNext"
  return 1
}
if ! "$binary" run -test -config "$configTmp" >/dev/null 2>&1; then
  echo -e "${WHITE}RproxyS config${RED} validation failed${cRES}"
  rm -f "$configTmp" "$configNext"
  return 1
fi

mkdir -p "$runtime" || { rm -f "$configTmp" "$configNext"; return 1; }
systemctl stop RproxyS >/dev/null 2>&1 || true
install -m 0755 "$binary" "$runtime/RproxyS" || { rm -f "$configTmp" "$configNext"; return 1; }
install -m 0600 "$configTmp" "$runtime/config.json" || { rm -f "$configTmp" "$configNext"; return 1; }
rm -f "$configTmp" "$configNext"

serviceTmp=$(mktemp /tmp/de_GWD-RproxyS-service.XXXXXX) || return 1
cat << "EOF" >"$serviceTmp"
[Unit]
Description=de_GWD RproxyS reverse proxy
After=network.target nss-lookup.target

[Service]
User=root
Type=simple
ExecStart=/opt/de_GWD/RproxyS/RproxyS run -config /opt/de_GWD/RproxyS/config.json
Restart=always
RestartSec=2
TimeoutStopSec=5

AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
EOF
if ! install -m 0644 "$serviceTmp" /etc/systemd/system/RproxyS.service; then
  rm -f "$serviceTmp"
  return 1
fi
rm -f "$serviceTmp"

systemctl daemon-reload >/dev/null 2>&1 || return 1
systemctl enable RproxyS >/dev/null 2>&1 || return 1
if ! systemctl restart RproxyS >/dev/null 2>&1 || ! systemctl is-active --quiet RproxyS; then
  echo -e "${WHITE}RproxyS${RED} start failed${cRES}"
  return 1
fi
return 0
}


RproxySstop(){
local settings=/opt/de_GWD/RproxyS/settings.json
local settingsTmp

systemctl disable --now RproxyS >/dev/null 2>&1 || true
rm -f /etc/systemd/system/RproxyS.service /lib/systemd/system/RproxyS.service
rm -f /opt/de_GWD/RproxyS/RproxyS /opt/de_GWD/RproxyS/config.json

if [[ -f $settings ]]; then
  settingsTmp=$(mktemp /tmp/de_GWD-RproxyS-settings.XXXXXX) || return 1
  if ! jq '.enabled=false' "$settings" >"$settingsTmp" || ! install -m 0600 "$settingsTmp" "$settings"; then
    rm -f "$settingsTmp"
    return 1
  fi
  rm -f "$settingsTmp"
fi
systemctl daemon-reload >/dev/null 2>&1 || return 1
return 0
}


printRproxyS(){
local settings=/opt/de_GWD/RproxyS/settings.json
local domain port uuid clients

[[ -f $settings ]] || return 1
[[ $(jq -r 'if .enabled == false then "false" else "true" end' "$settings" 2>/dev/null) = "true" ]] || return 1
domain=$(awk '/server_name/ {print $2;exit}' /etc/nginx/conf.d/default.conf 2>/dev/null | sed 's/[;.]$//')
[[ -n $domain ]] || domain="server-domain"
port=$(jq -r '.port // empty' "$settings" 2>/dev/null)
uuid=$(jq -r '.uuid // empty' "$settings" 2>/dev/null)

echo -e "${BLUE}------------------------------------------------ ${cRES}"
echo -e "${GREEN}RproxyS Reverse Proxy${cRES}"
echo -e "${BLUE}Address:       ${YELLOW}$domain:$port${cRES}"
echo -e "${BLUE}Tunnel UUID:   ${YELLOW}$uuid${cRES}"
echo -e "${BLUE}Tunnel URL:    ${YELLOW}vmess://$uuid@$domain:$port?encryption=auto&type=tcp&tfo=1#$domain:$port${cRES}"
clients=$(jq -r '.clients[]? // empty' "$settings" 2>/dev/null)
if [[ -n $clients ]]; then
  echo -e "${BLUE}Client UUIDs:${cRES}"
  while IFS= read -r uuid; do
    [[ -z $uuid ]] && continue
    echo -e "  ${YELLOW}$uuid${cRES}"
    echo -e "  ${YELLOW}vmess://$uuid@$domain:$port?encryption=auto&type=tcp&tfo=1#$domain:$port${cRES}"
  done <<< "$clients"
fi
jq -r '.mapping[]? | "Mapping: \(.port)/\(.protocol)"' "$settings" 2>/dev/null
echo -e "${BLUE}------------------------------------------------ ${cRES}"
}


changeRproxyS(){
local settings=/opt/de_GWD/RproxyS/settings.json
local oldPort oldUUID oldClients oldMapping switch RproxyStunnelPort RproxyStunnelUUID RproxySClients RproxySMappings
local temp backup clientUUID mapping mappingPort mappingProtocol clientUUIDs mappings

oldPort=$(jq -r '.port // empty' "$settings" 2>/dev/null)
oldUUID=$(jq -r '.uuid // empty' "$settings" 2>/dev/null)
oldClients=$(jq -r '.clients[]? // empty' "$settings" 2>/dev/null | paste -sd, -)
oldMapping=$(jq -r '.mapping[]? | "\(.port)/\(.protocol)"' "$settings" 2>/dev/null | paste -sd, -)

echo -e "${GREEN}============================ ${cRES}"
echo -e "${GREEN}[1]: Enable/configure RproxyS${cRES}"
echo -e "${GREEN}[2]: Disable RproxyS${cRES}"
echo -e "${GREEN}[3]: Show RproxyS settings${cRES}"
echo -e "${GREEN}============================ ${cRES}"
read -r -n 1 switch
echo

if [[ $switch = "2" ]]; then
  RproxySstop || return 1
  echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}RproxyS ${RED}Disabled${cRES}"
  return 0
fi
if [[ $switch = "3" ]]; then
  printRproxyS || echo -e "${YELLOW}RproxyS is not enabled${cRES}"
  return 0
fi
[[ $switch = "1" ]] || return 0
[[ -x /opt/de_GWD/vtrui/vtrui ]] || { echo -e "${RED}Install de_GWD first${cRES}"; return 1; }

read -r -p "RproxyS listen port [$oldPort]: " RproxyStunnelPort
RproxyStunnelPort=${RproxyStunnelPort:-$oldPort}
RproxyStunnelPort=${RproxyStunnelPort:-20000}
RproxyS_valid_port "$RproxyStunnelPort" || { echo -e "${RED}Invalid port${cRES}"; return 1; }

read -r -p "RproxyS UUID [$oldUUID]: " RproxyStunnelUUID
RproxyStunnelUUID=${RproxyStunnelUUID:-$oldUUID}
RproxyStunnelUUID=${RproxyStunnelUUID:-$(cat /proc/sys/kernel/random/uuid)}
RproxyS_valid_uuid "$RproxyStunnelUUID" || { echo -e "${RED}Invalid UUID${cRES}"; return 1; }

read -r -p "Extra client UUIDs, comma separated [$oldClients] (use - to clear): " RproxySClients
if [[ $RproxySClients = "-" ]]; then
  RproxySClients=""
else
  RproxySClients=${RproxySClients:-$oldClients}
fi
read -r -p "Server mappings, port/protocol comma separated [$oldMapping] (use - to clear): " RproxySMappings
if [[ $RproxySMappings = "-" ]]; then
  RproxySMappings=""
else
  RproxySMappings=${RproxySMappings:-$oldMapping}
fi

temp=$(mktemp /tmp/de_GWD-RproxyS-settings.XXXXXX) || return 1
if ! jq -n --argjson port "$RproxyStunnelPort" --arg uuid "$RproxyStunnelUUID" \
  '{enabled:true,port:$port,uuid:$uuid,clients:[],mapping:[]}' >"$temp"; then
  rm -f "$temp"
  return 1
fi

IFS=',' read -r -a clientUUIDs <<< "$RproxySClients"
for clientUUID in "${clientUUIDs[@]}"; do
  clientUUID=${clientUUID//[[:space:]]/}
  [[ -z $clientUUID ]] && continue
  RproxyS_valid_uuid "$clientUUID" || { rm -f "$temp"; echo -e "${RED}Invalid client UUID${cRES}"; return 1; }
  if ! jq --arg id "$clientUUID" '.clients += [$id]' "$temp" | sponge "$temp"; then
    rm -f "$temp"
    return 1
  fi
done

IFS=',' read -r -a mappings <<< "$RproxySMappings"
for mapping in "${mappings[@]}"; do
  mapping=${mapping//[[:space:]]/}
  [[ -z $mapping ]] && continue
  mappingPort=${mapping%%/*}
  mappingProtocol=${mapping#*/}
  RproxyS_valid_port "$mappingPort" || { rm -f "$temp"; echo -e "${RED}Invalid mapping: $mapping${cRES}"; return 1; }
  [[ $mappingPort != "$RproxyStunnelPort" ]] || { rm -f "$temp"; echo -e "${RED}Mapping conflicts with tunnel port${cRES}"; return 1; }
  [[ $mappingProtocol = "tcp" || $mappingProtocol = "udp" || $mappingProtocol = "tcp,udp" ]] || {
    rm -f "$temp"
    echo -e "${RED}Invalid mapping protocol${cRES}"
    return 1
  }
  if ! jq --argjson port "$mappingPort" --arg protocol "$mappingProtocol" \
    '.mapping += [{port:$port,protocol:$protocol}]' "$temp" | sponge "$temp"; then
    rm -f "$temp"
    return 1
  fi
done

mkdir -p /opt/de_GWD/RproxyS || { rm -f "$temp"; return 1; }
if [[ -f $settings ]]; then
  backup=$(mktemp /tmp/de_GWD-RproxyS-settings-backup.XXXXXX) || { rm -f "$temp"; return 1; }
  cp -f "$settings" "$backup" || { rm -f "$temp" "$backup"; return 1; }
else
  backup=""
fi
mv -f "$temp" "$settings"
chmod 0600 "$settings"

if ! RproxySsave; then
  if [[ -n $backup ]]; then
    mv -f "$backup" "$settings"
    chmod 0600 "$settings"
    RproxySsave >/dev/null 2>&1 || true
  else
    rm -f "$settings"
  fi
  echo -e "${RED}RproxyS start failed${cRES}"
  return 1
fi
[[ -n $backup ]] && rm -f "$backup"
printRproxyS
echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}RproxyS ${GREEN}Enabled${cRES}"
}


# Menu 44: multi-rule HAProxy TCP forwarding (public local port -> upstream host:port).
# Rules are kept separately from RproxyS mappings so one server can expose several
# independent TCP forwards without overwriting the previous HAProxy frontend.
tcppf_settings=${DE_GWD_TCPPF_SETTINGS}

tcppf_write_settings(){
local content=$1 temp
mkdir -p -- "$(dirname -- "$DE_GWD_TCPPF_SETTINGS")" || return 1
temp=$(mktemp "${DE_GWD_TCPPF_SETTINGS}.tmp.XXXXXX") || return 1
if ! printf '%s\n' "$content" >"$temp" || ! chmod 0600 "$temp" || ! mv -f -- "$temp" "$DE_GWD_TCPPF_SETTINGS"; then
  rm -f -- "$temp"
  return 1
fi
}

tcppf_load(){
local rules='[]' feName bind localP up parsed host upPort
mkdir -p -- "$(dirname -- "$DE_GWD_TCPPF_SETTINGS")" || return 1
if [[ ! -f $DE_GWD_TCPPF_SETTINGS ]]; then
  # Migrate the original single-frontend configuration once, if it exists.
  if [[ -f $DE_GWD_HAPROXY_CONFIG ]]; then
    while IFS= read -r feName; do
      [[ -n $feName ]] || continue
      bind=$(awk -v name="$feName" '
        $1 == "frontend" && $2 == name {inside=1; next}
        inside && $1 == "frontend" {exit}
        inside && $1 == "bind" {print $2; exit}
      ' "$DE_GWD_HAPROXY_CONFIG" 2>/dev/null)
      localP=${bind##*:}
      up=$(awk -v name="$feName" '
        $1 == "backend" && $2 == name {inside=1; next}
        inside && $1 == "backend" {exit}
        inside && $1 == "server" && $2 == "endpoint" {print $3; exit}
      ' "$DE_GWD_HAPROXY_CONFIG" 2>/dev/null)
      [[ $localP =~ ^[0-9]+$ ]] && (( localP >= 1 && localP <= 65535 )) || continue
      parsed=$(parseDomainPort "$up" 2>/dev/null) || continue
      host=; upPort=
      read -r host upPort <<<"$parsed"
      [[ -n $host && $upPort =~ ^[0-9]+$ ]] && (( upPort >= 1 && upPort <= 65535 )) || continue
      up=$(formatDomainPort "$host" "$upPort")
      if ! jq -e --argjson lp "$localP" '.[] | select(.localPort == $lp)' <<<"$rules" >/dev/null 2>&1; then
        rules=$(jq -c --argjson lp "$localP" --arg upstream "$up" '. + [{localPort:$lp, upstream:$upstream}]' <<<"$rules") || return 1
      fi
    done < <(awk '$1 == "frontend" {print $2}' "$DE_GWD_HAPROXY_CONFIG" 2>/dev/null)
  fi
  tcppf_write_settings "$(jq -cn --argjson rules "$rules" '{rules:$rules}')" || return 1
fi
if ! jq -e '.rules | type == "array"' "$DE_GWD_TCPPF_SETTINGS" >/dev/null 2>&1; then
  echo -e "${RED}TCP Port Forward settings are invalid${cRES}" >&2
  return 1
fi
TCPPFrules=$(jq -c '.rules' "$DE_GWD_TCPPF_SETTINGS") || return 1
}

tcppf_validate_rules(){
local n i localP upstream parsed host upPort
n=$(jq 'length' <<<"${TCPPFrules:-[]}" 2>/dev/null) || return 1
for (( i=0; i<n; i++ )); do
  localP=$(jq -r --argjson i "$i" '.[$i].localPort // empty' <<<"$TCPPFrules")
  upstream=$(jq -r --argjson i "$i" '.[$i].upstream // empty' <<<"$TCPPFrules")
  [[ $localP =~ ^[0-9]+$ ]] && (( localP >= 1 && localP <= 65535 )) || {
    echo -e "${RED}Invalid TCP forward local port${cRES}" >&2
    return 1
  }
  parsed=$(parseDomainPort "$upstream" 2>/dev/null) || {
    echo -e "${RED}Invalid TCP forward upstream${cRES}" >&2
    return 1
  }
  host=; upPort=
  read -r host upPort <<<"$parsed"
  [[ -n $host && $upPort =~ ^[0-9]+$ ]] && (( upPort >= 1 && upPort <= 65535 )) || {
    echo -e "${RED}TCP forward upstream must be host:port${cRES}" >&2
    return 1
  }
  if jq -e --argjson lp "$localP" --argjson i "$i" '.[:$i] | any(.[]?; .localPort == $lp)' <<<"$TCPPFrules" >/dev/null 2>&1; then
    echo -e "${RED}Duplicate TCP forward local port: $localP${cRES}" >&2
    return 1
  fi
done
return 0
}

tcppf_port_available(){
local candidate=$1 settings usedPort mainPort tunnelPort mappingPort
mainPort=${port:-$(awk '$1 == "listen" && $2 ~ /^[1-9][0-9]{0,4}$/ && $3 == "default" {print $2; exit}' "$DE_GWD_NGINX_CONF_DIR/default.conf" 2>/dev/null)}
[[ $candidate = "$mainPort" || $candidate = "9890" || $candidate = "9891" ]] && return 1
for settings in "$DE_GWD_DATA_DIR/vless.json" "$DE_GWD_DATA_DIR/reality.json" "$DE_GWD_DATA_DIR/socks5.json" "$DE_GWD_DATA_DIR/dokodemo.json"; do
  [[ -f $settings ]] || continue
  usedPort=$(jq -r '.port // empty' "$settings" 2>/dev/null)
  [[ $candidate = "$usedPort" ]] && return 1
done
settings="$DE_GWD_DATA_DIR/RproxyS/settings.json"
if [[ -f $settings ]]; then
  tunnelPort=$(jq -r '.port // empty' "$settings" 2>/dev/null)
  [[ $candidate = "$tunnelPort" ]] && return 1
  while IFS= read -r mappingPort; do
    [[ $candidate = "$mappingPort" ]] && return 1
  done < <(jq -r '.mapping[]?.port // empty' "$settings" 2>/dev/null)
fi
return 0
}

tcppf_install_haproxy(){
if [[ $DE_GWD_TEST_MODE = 1 ]]; then
  return 0
fi
unset aptPKG
[[ -z $(dpkg -l 2>/dev/null | awk '{print$2}' | grep '^haproxy$') ]] && aptPKG+=(haproxy)
if [[ -n ${aptPKG:-} ]]; then
  apt update && apt install -y "${aptPKG[@]}" || return 1
fi
mkdir -p -- "$(dirname -- "$DE_GWD_HAPROXY_SERVICE")" || return 1
cat >"$DE_GWD_HAPROXY_SERVICE" <<EOF
[Unit]
Description=HAProxy
After=network.target rsyslog.service

[Service]
User=root
Type=notify
EnvironmentFile=-/etc/default/haproxy
Environment="CONFIG=$DE_GWD_HAPROXY_CONFIG" "PIDFILE=/run/haproxy.pid"
ExecStartPre=/usr/sbin/haproxy -f \$CONFIG -c -q \$EXTRAOPTS
ExecStart=/usr/sbin/haproxy -Ws -f \$CONFIG -p \$PIDFILE \$EXTRAOPTS
ExecReload=/usr/sbin/haproxy -f \$CONFIG -c -q \$EXTRAOPTS
ExecReload=/bin/kill -USR2 \$MAINPID
KillMode=mixed
Restart=always
RestartSec=2
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
EOF
systemctl daemon-reload >/dev/null 2>&1 || return 1
}

tcppf_render_config(){
local temp i n localP upstream name configDir
configDir=$(dirname -- "$DE_GWD_HAPROXY_CONFIG")
mkdir -p -- "$configDir" || return 1
temp=$(mktemp "${DE_GWD_HAPROXY_CONFIG}.tmp.XXXXXX") || return 1
cat >"$temp" <<'EOF'
global
  ulimit-n              500000
  maxconn               200000

defaults
  mode                  tcp
  option                dontlognull
  timeout connect       10s
  timeout client        1m
  timeout server        1m
  timeout check         10s

resolvers local
  nameserver            dns 127.0.0.1:53
  resolve_retries       3
  timeout retry         3s
  hold valid            10s
  accepted_payload_size 8192
EOF
n=$(jq 'length' <<<"$TCPPFrules") || { rm -f -- "$temp"; return 1; }
for (( i=0; i<n; i++ )); do
  localP=$(jq -r --argjson i "$i" '.[$i].localPort' <<<"$TCPPFrules")
  upstream=$(jq -r --argjson i "$i" '.[$i].upstream' <<<"$TCPPFrules")
  name="p${localP}"
  cat >>"$temp" <<EOF

frontend $name
  bind                  :$localP
  default_backend       $name

backend $name
  server endpoint $upstream check resolvers local init-addr none
EOF
done
chmod 0644 "$temp" && mv -f -- "$temp" "$DE_GWD_HAPROXY_CONFIG" || {
  rm -f -- "$temp"
  return 1
}
}

tcppf_apply_runtime(){
local n checkLog
tcppf_load || return 1
tcppf_validate_rules || return 1
n=$(jq 'length' <<<"$TCPPFrules") || return 1
if (( n == 0 )); then
  systemctl stop haproxy >/dev/null 2>&1 || true
  systemctl disable haproxy >/dev/null 2>&1 || true
  rm -f -- "$DE_GWD_HAPROXY_CONFIG"
  return 0
fi
tcppf_install_haproxy || return 1
tcppf_render_config || return 1
checkLog=$(mktemp "${DE_GWD_TXN_TMPDIR:-/tmp}/de_GWD-haproxy-check.XXXXXX") || return 1
if ! "$DE_GWD_HAPROXY_BIN" -f "$DE_GWD_HAPROXY_CONFIG" -c -q >"$checkLog" 2>&1; then
  echo -e "${WHITE}[ ${RED}✕ ${WHITE}]\c" && echo -e "\t${WHITE}HAProxy config invalid${cRES}" >&2
  sed -n '1,15p' "$checkLog" >&2
  rm -f -- "$checkLog"
  return 1
fi
rm -f -- "$checkLog"
systemctl enable haproxy >/dev/null 2>&1 || return 1
systemctl restart haproxy >/dev/null 2>&1 || return 1
if ! systemctl is-active --quiet haproxy; then
  echo -e "${WHITE}[ ${RED}✕ ${WHITE}]\c" && echo -e "\t${WHITE}HAProxy failed to start${cRES}" >&2
  systemctl status haproxy --no-pager -l 2>&1 | sed -n '1,15p' >&2
  return 1
fi
}

tcppf_apply_candidate(){
local candidate=$1
mv -f -- "$candidate" "$DE_GWD_TCPPF_SETTINGS" || return 1
tcppf_apply_runtime
}

tcppf_apply_transaction(){
local candidate=$1
configTransaction "haproxy" tcppf_apply_candidate \
  "$DE_GWD_TCPPF_SETTINGS" \
  "$DE_GWD_HAPROXY_CONFIG" \
  "$DE_GWD_HAPROXY_SERVICE" \
  -- "$candidate"
}

tcppf_apply(){
tcppf_apply_runtime
}

tcppf_list(){
local domain n i localP upstream
tcppf_load || return 1
tcppf_validate_rules || return 1
domain=$(getServerDomain 2>/dev/null || true)
[[ -n $domain ]] || domain="0.0.0.0"
n=$(jq 'length' <<<"$TCPPFrules") || return 1
echo -e "${GREEN}================================================ ${cRES}"
echo -e "${GREEN} TCP Port Forward (multi)${cRES}"
echo -e "${GREEN}================================================ ${cRES}"
if (( n == 0 )); then
  echo -e "${YELLOW}(empty)${cRES}"
else
  printf '%-4s %-24s %s\n' "ID" "Public" "Upstream"
  for (( i=0; i<n; i++ )); do
    localP=$(jq -r --argjson i "$i" '.[$i].localPort' <<<"$TCPPFrules")
    upstream=$(jq -r --argjson i "$i" '.[$i].upstream' <<<"$TCPPFrules")
    printf '%-4s %-24s %s\n' "$((i + 1))" "$domain:$localP" "$upstream"
  done
fi
echo -e "${GREEN}================================================ ${cRES}"
}

tcppf_add(){
local upDomainP localP parsed host upPort candidate
tcppf_load || return 1
tcppf_validate_rules || return 1
echo -e "${GREEN}======================= ${cRES}"
echo -e "${GREEN}Upstream Domain & Port${cRES}"
echo -e "${GREEN}(host:port or [IPv6]:port)${cRES}"
echo -e "${GREEN}======================= ${cRES}"
read -r upDomainP
parsed=$(parseDomainPort "$upDomainP" 2>/dev/null) || {
  echo -e "${WHITE}[ ${RED}✕ ${WHITE}]\c" && echo -e "\t${WHITE}Upstream must be host:port${cRES}"
  return 1
}
host=; upPort=
read -r host upPort <<<"$parsed"
if [[ -z $host || ! $upPort =~ ^[0-9]+$ ]] || (( upPort < 1 || upPort > 65535 )); then
  echo -e "${WHITE}[ ${RED}✕ ${WHITE}]\c" && echo -e "\t${WHITE}Upstream must be host:port${cRES}"
  return 1
fi
upDomainP=$(formatDomainPort "$host" "$upPort")
echo -e "${GREEN}======================= ${cRES}"
echo -e "${GREEN}Local Port${cRES}"
echo -e "${GREEN}======================= ${cRES}"
read -r localP
if [[ ! $localP =~ ^[0-9]{1,5}$ ]]; then
  echo -e "${WHITE}[ ${RED}✕ ${WHITE}]\c" && echo -e "\t${WHITE}Invalid local port${cRES}"
  return 1
fi
localP=$((10#$localP))
if (( localP < 1 || localP > 65535 )); then
  echo -e "${WHITE}[ ${RED}✕ ${WHITE}]\c" && echo -e "\t${WHITE}Invalid local port${cRES}"
  return 1
fi
if ! tcppf_port_available "$localP"; then
  echo -e "${WHITE}[ ${RED}✕ ${WHITE}]\c" && echo -e "\t${WHITE}Local port $localP is already in use${cRES}"
  return 1
fi
if jq -e --argjson lp "$localP" '.[] | select(.localPort == $lp)' <<<"$TCPPFrules" >/dev/null 2>&1; then
  echo -e "${WHITE}[ ${RED}✕ ${WHITE}]\c" && echo -e "\t${WHITE}Local port $localP already exists${cRES}"
  return 1
fi
candidate=$(mktemp "${DE_GWD_TXN_TMPDIR:-/tmp}/de_GWD-tcppf-candidate.XXXXXX") || return 1
if ! jq --argjson lp "$localP" --arg upstream "$upDomainP" \
  '.rules += [{localPort:$lp, upstream:$upstream}]' "$DE_GWD_TCPPF_SETTINGS" >"$candidate"; then
  rm -f -- "$candidate"
  return 1
fi
if ! tcppf_apply_transaction "$candidate"; then
  rm -f -- "$candidate"
  return 1
fi
rm -f -- "$candidate"
echo -e "${BLUE}------------------------------------------------ ${cRES}"
echo -e "${GREEN}TCP Port Forward${cRES}"
echo -e "${BLUE}Upstream:      ${YELLOW}$upDomainP${cRES}"
echo -e "${BLUE}Local port:    ${YELLOW}$localP${cRES}"
echo -e "${BLUE}------------------------------------------------ ${cRES}"
echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}TCP Port Forward ${GREEN}Added${cRES}"
}

tcppf_del(){
local n delID index i localP candidate
tcppf_load || return 1
tcppf_validate_rules || return 1
n=$(jq 'length' <<<"$TCPPFrules") || return 1
if (( n == 0 )); then
  echo -e "${WHITE}[ ${YELLOW}! ${WHITE}]\c" && echo -e "\t${WHITE}No TCP Port Forward rules${cRES}"
  return 1
fi
tcppf_list || return 1
read -r -p "Delete ID or local port (all = delete all): " delID
if [[ $delID = all ]]; then
  tcppf_del_all
  return $?
fi
index=
if [[ $delID =~ ^[0-9]+$ ]]; then
  for (( i=0; i<n; i++ )); do
    if [[ $(jq -r --argjson i "$i" '.[$i].localPort' <<<"$TCPPFrules") = "$delID" ]]; then
      index=$i
      break
    fi
  done
  if [[ -z $index ]] && (( delID >= 1 && delID <= n )); then
    index=$((delID - 1))
  fi
fi
if [[ -z $index ]]; then
  echo -e "${WHITE}[ ${RED}✕ ${WHITE}]\c" && echo -e "\t${WHITE}Invalid ID or local port${cRES}"
  return 1
fi
candidate=$(mktemp "${DE_GWD_TXN_TMPDIR:-/tmp}/de_GWD-tcppf-candidate.XXXXXX") || return 1
if ! jq --argjson i "$index" 'del(.rules[$i])' "$DE_GWD_TCPPF_SETTINGS" >"$candidate" || ! tcppf_apply_transaction "$candidate"; then
  rm -f -- "$candidate"
  return 1
fi
rm -f -- "$candidate"
echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}TCP Port Forward ${GREEN}Deleted${cRES}"
}

tcppf_del_all(){
local candidate
tcppf_load || return 1
candidate=$(mktemp "${DE_GWD_TXN_TMPDIR:-/tmp}/de_GWD-tcppf-candidate.XXXXXX") || return 1
printf '%s\n' '{"rules":[]}' >"$candidate"
if ! tcppf_apply_transaction "$candidate"; then
  rm -f -- "$candidate"
  return 1
fi
rm -f -- "$candidate"
echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}All TCP Port Forward ${GREEN}Deleted${cRES}"
}

changeTCPPF(){
local tcpPFsw
while true; do
  clear
  tcppf_list || return 1
  echo -e "${GREEN}1. Add TCP Port Forward${cRES}"
  echo -e "${GREEN}2. Delete one rule${cRES}"
  echo -e "${GREEN}3. Delete all${cRES}"
  echo -e "${GREEN}0. Back${cRES}"
  echo -e "${GREEN}================================================ ${cRES}"
  read -r -p "Select: " tcpPFsw
  case "$tcpPFsw" in
    1) tcppf_add; read -r -n 1 -s -p "Press any key..."; echo ;;
    2) tcppf_del; read -r -n 1 -s -p "Press any key..."; echo ;;
    3) tcppf_del_all; read -r -n 1 -s -p "Press any key..."; echo ;;
    0) break ;;
    *) ;;
  esac
done
}


vmessURL(){
local vmessJSON
vmessJSON=$(jq -cn \
  --arg remark "$7" \
  --arg address "$1" \
  --arg port "$2" \
  --arg uuid "$3" \
  --arg network "$4" \
  --arg host "$5" \
  --arg path "$6" \
  --arg tls "$5" \
  '{
    v:"2",
    ps:$remark,
    add:$address,
    port:$port,
    id:$uuid,
    aid:"0",
    scy:"auto",
    net:$network,
    type:"none",
    host:$host,
    path:$path,
    tls:(if $tls == "" then "" else "tls" end),
    sni:$tls
  }')
echo "vmess://$(printf '%s' "$vmessJSON" | base64 -w0)"
}

vlessURL(){
local pathEncoded
pathEncoded=$(printf '%s' "$4" | jq -sRr @uri)
printf 'vless://%s@%s:%s?encryption=none&security=tls&type=ws&host=%s&sni=%s&path=%s#%s\n' "$3" "$1" "$2" "$1" "$1" "$pathEncoded" "$5"
}

vlessRealityURL(){
printf 'vless://%s@%s:%s?encryption=none&security=reality&sni=%s&fp=chrome&pbk=%s&sid=%s&flow=xtls-rprx-vision&type=tcp#%s\n' "$3" "$1" "$2" "$4" "$5" "$6" "$7"
}

printNode(){
local domain=""
local nodeUUID
vpsdomain=$(getServerDomain 2>/dev/null || true)
[[ $vpsdomain =~ ^[A-Za-z0-9.-]+$ ]] || { echo -e "${RED}Server domain is unavailable${cRES}"; return 1; }
