}

warp_render_scripts(){
  local mode=${1:-ipv4}
  mkdir -p -- "$(dirname -- "$DE_GWD_WARP_POSTUP")" "$(dirname -- "$DE_GWD_WARP_POSTDOWN")" || return 1

  cat << 'EOF_POSTUP' > "$DE_GWD_WARP_POSTUP"
#!/bin/bash
localAddrIPv4=$(ip -4 a 2>/dev/null | grep inet | grep -v '127.0.0.1' | awk '{print $2}' | cut -d'/' -f1 | head -n 1)
localAddrIPv6=$(ip -6 a 2>/dev/null | grep inet6 | grep -v '::1' | grep -v '^fe80' | awk '{print $2}' | cut -d'/' -f1 | head -n 1)
sshPort=$(ss -tlpn 2>/dev/null | grep -E 'sshd|ssh' | awk '{print $4}' | awk -F':' '{print $NF}' | head -n 1)
[[ -z $sshPort ]] && sshPort=$(grep -E '^Port ' /etc/ssh/sshd_config 2>/dev/null | awk '{print $2}' | head -n 1)
sshPort=${sshPort:-22}

[[ -n $localAddrIPv4 ]] && ip rule add from "$localAddrIPv4" lookup main priority 51810 2>/dev/null || true
[[ -n $localAddrIPv6 ]] && ip -6 rule add from "$localAddrIPv6" lookup main priority 51810 2>/dev/null || true

if [[ -n $sshPort ]]; then
  ip rule add sport "$sshPort" lookup main priority 51811 2>/dev/null || true
  ip rule add dport "$sshPort" lookup main priority 51811 2>/dev/null || true
  ip -6 rule add sport "$sshPort" lookup main priority 51811 2>/dev/null || true
  ip -6 rule add dport "$sshPort" lookup main priority 51811 2>/dev/null || true
fi

ip rule add to 127.0.0.0/8 lookup main priority 51812 2>/dev/null || true
ip rule add to 10.0.0.0/8 lookup main priority 51812 2>/dev/null || true
ip rule add to 172.16.0.0/12 lookup main priority 51812 2>/dev/null || true
ip rule add to 192.168.0.0/16 lookup main priority 51812 2>/dev/null || true
ip rule add to 169.254.0.0/16 lookup main priority 51812 2>/dev/null || true
ip -6 rule add to ::1/128 lookup main priority 51812 2>/dev/null || true
ip -6 rule add to fe80::/10 lookup main priority 51812 2>/dev/null || true

endpointHost=$(awk -F'[: ]+' '/EndPoint|Endpoint/{print $2}' "${DE_GWD_WGCF_CONF:-/etc/wireguard/wgcf.conf}" 2>/dev/null | head -n 1)
if [[ -n $endpointHost ]]; then
  for ep in $(getent ahosts "$endpointHost" 2>/dev/null | awk '{print $1}' | sort -u); do
    if [[ $ep =~ : ]]; then
      ip -6 rule add to "$ep" lookup main priority 51813 2>/dev/null || true
    else
      ip rule add to "$ep" lookup main priority 51813 2>/dev/null || true
    fi
  done
fi

ip rule add lookup 51820 priority 51820 2>/dev/null || true
EOF_POSTUP

  if [[ $mode == "dual" ]]; then
    cat << 'EOF_DUAL' >> "$DE_GWD_WARP_POSTUP"
ip -6 rule add lookup 51820 priority 51820 2>/dev/null || true
EOF_DUAL
  fi

  chmod +x "$DE_GWD_WARP_POSTUP" || return 1

  cat << 'EOF_POSTDOWN' > "$DE_GWD_WARP_POSTDOWN"
#!/bin/bash
ip rule del priority 51810 2>/dev/null || true
ip rule del priority 51811 2>/dev/null || true
ip rule del priority 51811 2>/dev/null || true
ip rule del priority 51812 2>/dev/null || true
ip rule del priority 51812 2>/dev/null || true
ip rule del priority 51812 2>/dev/null || true
ip rule del priority 51812 2>/dev/null || true
ip rule del priority 51812 2>/dev/null || true
ip rule del priority 51813 2>/dev/null || true
ip rule del priority 51820 2>/dev/null || true

ip -6 rule del priority 51810 2>/dev/null || true
ip -6 rule del priority 51811 2>/dev/null || true
ip -6 rule del priority 51811 2>/dev/null || true
ip -6 rule del priority 51812 2>/dev/null || true
ip -6 rule del priority 51812 2>/dev/null || true
ip -6 rule del priority 51813 2>/dev/null || true
ip -6 rule del priority 51820 2>/dev/null || true

ip route flush table 51820 2>/dev/null || true
ip -6 route flush table 51820 2>/dev/null || true
EOF_POSTDOWN

  chmod +x "$DE_GWD_WARP_POSTDOWN" || return 1
}

warp_render_config(){
  local mode=${1:-ipv4}
  local profileSource=${2:-wgcf-profile.conf}
  local privateKey publicKey endpoint addresses reserved

  if [[ -f $profileSource ]]; then
    privateKey=$(sed -n 's/^[[:space:]]*PrivateKey[[:space:]]*=[[:space:]]*//p' "$profileSource" | tr -d '\r\n' | head -n 1)
    publicKey=$(sed -n 's/^[[:space:]]*PublicKey[[:space:]]*=[[:space:]]*//p' "$profileSource" | tr -d '\r\n' | head -n 1)
    endpoint=$(sed -n -E 's/^[[:space:]]*[eE]nd[pP]oint[[:space:]]*=[[:space:]]*//p' "$profileSource" | tr -d '\r\n' | head -n 1)
    addresses=$(grep -E '^[[:space:]]*Address[[:space:]]*=' "$profileSource")
    reserved=$(grep -E '^[[:space:]]*(Reserved|reserved)[[:space:]]*=' "$profileSource" | head -n 1)
  fi

  [[ -z $privateKey ]] && privateKey="PLACEHOLDER_PRIVATE_KEY="
  [[ -z $publicKey ]] && publicKey="bmXOC+F1FxEMF9dyiK2H5/1SUtzH0JuVo51h2wPfgyo="
  [[ -z $endpoint ]] && endpoint="engage.cloudflareclient.com:2408"
  if [[ -z $addresses ]]; then
    addresses="Address = 172.16.0.2/32"
    [[ $mode == "dual" ]] && addresses+=$'\n'"Address = 2606:4700:110:8a49:60ae:213b:a6f5:a7ff/128"
  fi

  mkdir -p -- "$(dirname -- "$DE_GWD_WGCF_CONF")" || return 1
  local tmpCfg
  tmpCfg=$(mktemp "${DE_GWD_WGCF_CONF}.tmp.XXXXXX") || return 1

  cat << EOF_WGCF > "$tmpCfg"
[Interface]
PrivateKey = $privateKey
$addresses
DNS = 1.1.1.1, 8.8.8.8, 2606:4700:4700::1111
MTU = 1280
Table = 51820
PostUp = $DE_GWD_WARP_POSTUP
PostDown = $DE_GWD_WARP_POSTDOWN

[Peer]
PublicKey = $publicKey
Endpoint = $endpoint
AllowedIPs = 0.0.0.0/0
$([[ $mode == "dual" ]] && echo "AllowedIPs = ::/0")
$([[ -n $reserved ]] && echo "$reserved")
PersistentKeepalive = 15
EOF_WGCF

  chmod 0600 "$tmpCfg" || { rm -f -- "$tmpCfg"; return 1; }
  mv -f -- "$tmpCfg" "$DE_GWD_WGCF_CONF" || return 1
}

warp_test_connectivity(){
  if [[ ${DE_GWD_TEST_MODE:-0} == 1 ]]; then
    return "${FAKE_WARP_FAIL:-0}"
  fi
  curl -4 -sSL --connect-timeout 4 --max-time 6 https://cloudflare.com/cdn-cgi/trace >/dev/null 2>&1 \
    || curl -4 -sSL --connect-timeout 4 --max-time 6 whatismyip.akamai.com >/dev/null 2>&1
}

warp_stop(){
  systemctl stop wg-quick@wgcf >/dev/null 2>&1 || true
  systemctl disable wg-quick@wgcf >/dev/null 2>&1 || true
  if [[ -x $DE_GWD_WARP_POSTDOWN ]]; then
    "$DE_GWD_WARP_POSTDOWN" >/dev/null 2>&1 || true
  fi
  mkdir -p -- "$(dirname -- "$DE_GWD_WARP_SETTINGS")" 2>/dev/null || true
  printf '{"enabled":false,"mode":"none"}\n' > "$DE_GWD_WARP_SETTINGS" 2>/dev/null || true
}

warp_start(){
  local mode=${1:-ipv4}
  warp_render_scripts "$mode" || return 1
  warp_render_config "$mode" "${2:-wgcf-profile.conf}" || return 1

  if [[ ${DE_GWD_TEST_MODE:-0} != 1 ]]; then
    sysctl -w net.ipv4.ip_forward=1 >/dev/null 2>&1 || true
    sysctl -w net.ipv6.conf.all.forwarding=1 >/dev/null 2>&1 || true
  fi

  systemctl daemon-reload >/dev/null 2>&1 || true
  systemctl enable wg-quick@wgcf >/dev/null 2>&1 || true
  if ! systemctl restart wg-quick@wgcf >/dev/null 2>&1; then
    warp_stop
    return 1
  fi

  if ! warp_test_connectivity; then
    echo -e "${RED}WARP connectivity test failed! Automatically rolling back...${cRES}"
    warp_stop
    return 1
  fi

  mkdir -p -- "$(dirname -- "$DE_GWD_WARP_SETTINGS")" 2>/dev/null || true
  printf '{"enabled":true,"mode":"%s"}\n' "$mode" > "$DE_GWD_WARP_SETTINGS" 2>/dev/null || true
  return 0
}

changeWGCF(){
