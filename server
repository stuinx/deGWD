getTopDomain(){
local host=${1%%:*}
host=${host%.}
local suffix=$(echo "$host" | awk -F. '{print $(NF-1)}')
local tld=$(echo "$host" | awk -F. '{print $NF}')
local root
if [[ ${#tld} -eq 2 ]] && [[ $suffix =~ ^(ac|asn|biz|co|com|edu|firm|gen|go|gob|gov|idv|ind|info|me|mil|name|net|ne|nom|or|org|plc|res|sch|school|web)$ ]]; then
root=$(echo "$host" | awk -F. '{print $(NF-2)"."$(NF-1)"."$NF}')
else
root=$(echo "$host" | awk -F. '{print $(NF-1)"."$NF}')
fi
[[ "$host" == "$root" ]] && echo "$root" || echo "${host#*.}"
}

parseDomainPort(){
local input=$1
if [[ $input =~ ^\[([0-9A-Fa-f:.]+)\]:([1-9][0-9]{0,4})$ ]]; then
printf '%s %s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
elif [[ $input =~ ^([A-Za-z0-9.-]+):([1-9][0-9]{0,4})$ ]]; then
printf '%s %s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
elif [[ $input =~ ^[A-Za-z0-9.-]+$ ]]; then
printf '%s\n' "$input"
else
return 1
fi
}

formatDomainPort(){
local host=$1
local port=$2
if [[ $host == *:* ]]; then
  printf '[%s]:%s\n' "$host" "$port"
else
  printf '%s:%s\n' "$host" "$port"
fi
}

removeLegacyVLESSWebConf(){
local temp=/tmp/de_GWD.vless-nginx.$$.conf
awk '
function braceDelta(line, opens, closes, text) {
  text=line
  opens=gsub(/\{/, "", text)
  text=line
  closes=gsub(/\}/, "", text)
  return opens-closes
}
BEGIN { inServer=0; depth=0; skip=0; block="" }
{
  if (!inServer && $0 ~ /^[[:space:]]*server[[:space:]]*\{[[:space:]]*$/) {
    inServer=1
    depth=braceDelta($0)
    block=$0 ORS
    next
  }
  if (inServer) {
    block=block $0 ORS
    if ($0 ~ /proxy_pass[[:space:]]+http:\/\/127\.0\.0\.1:9891;/) skip=1
    depth+=braceDelta($0)
    if (depth == 0) {
      if (!skip) printf "%s", block
      inServer=0
      depth=0
      skip=0
      block=""
    }
    next
  }
  print
}
END { if (inServer && !skip) printf "%s", block }
' "$DE_GWD_NGINX_CONF_DIR/default.conf" >"$temp" && mv -f "$temp" "$DE_GWD_NGINX_CONF_DIR/default.conf" || { rm -f "$temp"; return 1; }
}

getServerDomain(){
local serverDomain=${domain:-}
if [[ ! $serverDomain =~ ^[A-Za-z0-9.-]+$ ]]; then
  serverDomain=$(awk '$1 == "server_name" && $2 != ";" {gsub(/;/, "", $2); print $2; exit}' "$DE_GWD_NGINX_CONF_DIR/default.conf" 2>/dev/null)
fi
if [[ ! $serverDomain =~ ^[A-Za-z0-9.-]+$ ]]; then
  local settings
  for settings in "$DE_GWD_DATA_DIR/vless.json" "$DE_GWD_DATA_DIR/reality.json" "$DE_GWD_DATA_DIR/socks5.json" "$DE_GWD_DATA_DIR/dokodemo.json"; do
    serverDomain=$(jq -r '.domain // empty' "$settings" 2>/dev/null)
    [[ $serverDomain =~ ^[A-Za-z0-9.-]+$ ]] && break
  done
fi
[[ $serverDomain =~ ^[A-Za-z0-9.-]+$ ]] || return 1
printf '%s\n' "$serverDomain"
}

xrayPortAvailable(){
local candidate=$1
local currentSettings=$2
local settings usedPort mainPort currentPort
mainPort=${port:-$(awk '$1 == "listen" && $2 ~ /^[1-9][0-9]{0,4}$/ && $3 == "default" {print $2; exit}' "$DE_GWD_NGINX_CONF_DIR/default.conf" 2>/dev/null)}
[[ $candidate = "$mainPort" || $candidate = "9890" || $candidate = "9891" ]] && return 1
currentPort=$(jq -r '.port // empty' "$currentSettings" 2>/dev/null)
if [[ $candidate != "$currentPort" ]] && ss -H -lntu 2>/dev/null | awk -v candidate=":$candidate" '$4 ~ candidate "$" {found=1} END {exit !found}'; then
  return 1
fi
for settings in "$DE_GWD_DATA_DIR/vless.json" "$DE_GWD_DATA_DIR/reality.json" "$DE_GWD_DATA_DIR/socks5.json" "$DE_GWD_DATA_DIR/dokodemo.json" "$DE_GWD_DATA_DIR/RproxyS/settings.json"; do
  [[ $settings = "$currentSettings" || ! -f $settings ]] && continue
  usedPort=$(jq -r '.port // empty' "$settings" 2>/dev/null)
  [[ $candidate = "$usedPort" ]] && return 1
done
return 0
}

syncMainNodeState(){
local currentDomain currentPort currentPath currentUUIDs
currentDomain=$(awk '$1 == "server_name" && $2 != ";" {gsub(/;/, "", $2); print $2; exit}' "$DE_GWD_NGINX_CONF_DIR/default.conf" 2>/dev/null)
[[ $currentDomain =~ ^[A-Za-z0-9.-]+$ ]] && domain=$currentDomain
currentPort=$(awk '$1 == "listen" && $2 ~ /^[0-9]+$/ && $2 > 0 && $2 <= 65535 && $3 == "default" {print $2; exit}' "$DE_GWD_NGINX_CONF_DIR/default.conf" 2>/dev/null)
if [[ $currentPort =~ ^[0-9]+$ ]] && (( currentPort > 0 && currentPort <= 65535 )); then
  port=$currentPort
fi
currentPath=$(jq -r '.inbounds[0].streamSettings.wsSettings.path // empty' "$DE_GWD_XRAY_DIR/config.json" 2>/dev/null)
[[ $currentPath == /* ]] && path=$currentPath
currentUUIDs=$(jq -r '.inbounds[0].settings.clients[].id // empty' "$DE_GWD_XRAY_DIR/config.json" 2>/dev/null)
uuids=$currentUUIDs
}

configLockAcquire(){
local lockFile=${DE_GWD_CONFIG_LOCK:-/run/lock/de_GWD-config.lock}
local lockDir=${lockFile%/*}
[[ $lockDir = "$lockFile" ]] && lockDir="."
command -v flock >/dev/null 2>&1 || {
  echo "flock is required for configuration changes" >&2
  return 1
}
mkdir -p -- "$lockDir" || return 1
exec 9>"$lockFile" || return 1
if ! flock -n 9; then
  exec 9>&-
  echo "another de_GWD configuration change is in progress" >&2
  return 1
fi
}

configLockRelease(){
flock -u 9 >/dev/null 2>&1 || true
exec 9>&-
}

configTxnStart(){
local backupDir manifest file backup index=0
backupDir=$(mktemp -d "${DE_GWD_TXN_TMPDIR:-/tmp}/de_GWD-config.XXXXXX") || return 1
manifest="$backupDir/manifest"
: >"$manifest" || { rm -rf -- "$backupDir"; return 1; }
for file in "$@"; do
  [[ -n $file ]] || continue
  index=$((index + 1))
  backup="$backupDir/$index"
  if [[ -e $file || -L $file ]]; then
    if ! cp -a -- "$file" "$backup"; then
      rm -rf -- "$backupDir"
      return 1
    fi
  else
    backup="-"
  fi
  printf '%s\t%s\n' "$file" "$backup" >>"$manifest" || {
    rm -rf -- "$backupDir"
    return 1
  }
done
DE_GWD_TXN_DIR=$backupDir
DE_GWD_TXN_MANIFEST=$manifest
}

configTxnRestore(){
local target backup
[[ -f ${DE_GWD_TXN_MANIFEST:-} ]] || return 1
while IFS=$'\t' read -r target backup; do
  [[ -n $target ]] || continue
  rm -rf -- "$target" || return 1
  if [[ $backup != "-" ]]; then
    mkdir -p -- "$(dirname -- "$target")" || return 1
    cp -a -- "$backup" "$target" || return 1
  fi
done <"$DE_GWD_TXN_MANIFEST"
}

configTxnFinish(){
local backupDir=${DE_GWD_TXN_DIR:-}
DE_GWD_TXN_DIR=
DE_GWD_TXN_MANIFEST=
[[ -n $backupDir ]] && rm -rf -- "$backupDir"
}

configTxnRestartServices(){
local service
for service in $1; do
  systemctl restart "$service" >/dev/null 2>&1 || return 1
done
}

configTransaction(){
local services=$1 callback=$2 file status restoreStatus
local -a files=()
shift 2
while [[ ${1:-} != "--" ]]; do
  [[ $# -gt 0 ]] || return 2
  files+=("$1")
  shift
done
shift

if [[ -n ${DE_GWD_TXN_DIR:-} ]]; then
  "$callback" "$@"
  return $?
fi

configLockAcquire || return 1
if ! configTxnStart "${files[@]}"; then
  configLockRelease
  return 1
fi

"$callback" "$@"
status=$?
if (( status != 0 )); then
  restoreStatus=0
  configTxnRestore || restoreStatus=$?
  if (( restoreStatus == 0 )) && [[ -n $services ]]; then
    configTxnRestartServices "$services" || restoreStatus=1
  fi
  (( restoreStatus == 0 )) || status=1
fi
configTxnFinish
configLockRelease
return "$status"
}

xrayValidateConfig(){
"$DE_GWD_XRAY_BIN" run -test -confdir "$DE_GWD_XRAY_DIR" >/dev/null 2>&1
}

xrayReloadApply(){
