echo
fi

if [[ $(jq -r '.enabled // false' "$DE_GWD_DATA_DIR/reality.json" 2>/dev/null) = "true" ]]; then
realityDomain=$(jq -r '.domain // empty' "$DE_GWD_DATA_DIR/reality.json" 2>/dev/null)
