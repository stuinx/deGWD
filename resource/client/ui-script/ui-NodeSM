#!/usr/bin/env python3
import copy
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile


def build_config(state, config, presets, selections=None):
    state, config = copy.deepcopy(state), copy.deepcopy(config)
    saved = state.setdefault('v2nodeDIV', {}).get('nodeSM') or {}
    if not isinstance(saved, dict):
        saved = {}
    state['v2nodeDIV']['nodeSM'] = saved
    for key in ('netflix', 'hdh', 'tvb', 'bahamut'):
        saved.pop(key, None)
    nodes = state.get('v2node', [])
    if selections is not None:
        if set(selections) != set(presets):
            raise ValueError('Incomplete preset selection')
        for key, number in selections.items():
            limit = 1 if presets[key].get('toggle') else len(nodes)
            if type(number) is not int or not 0 <= number <= limit:
                raise ValueError('Invalid node selection')
            if number == 0:
                saved.pop(key, None)
            else:
                saved[key] = 'proxy' if presets[key].get('toggle') else nodes[number - 1]['domain']
    config['outbounds'] = [o for o in config.get('outbounds', []) if not o.get('tag', '').startswith('nodeSM')]
    rules = config.setdefault('routing', {}).get('rules', [])
    legacy_direct = [presets[k]['domains'] for k in ('apple', 'steam')]
    rules = [rule for rule in rules if not rule.get('outboundTag', '').startswith('nodeSM')
             and not rule.get('ruleTag', '').startswith('preset-')
             and not (rule.get('outboundTag') == 'direct' and rule.get('domain') in legacy_direct)]
    preset_rules = []
    for key, preset in presets.items():
        tag = preset.get('default', 'default')
        selected = saved.get(key)
        if selected and preset.get('toggle'):
            tag = 'default'
        elif selected:
            node = next((n for n in nodes if n.get('domain') == selected), None)
            if node is None:
                saved.pop(key, None)
            else:
                address = node['domain']
                if address.startswith('['):
                    host, suffix = address[1:].split(']', 1)
                    port = int(suffix[1:]) if suffix else 443
                elif ':' in address:
                    host, port = address.rsplit(':', 1)
                    port = int(port)
                else:
                    host, port = address, 443
                if not host or not 1 <= port <= 65535 or not node.get('uuid'):
                    raise ValueError('Invalid node address or UUID')
                tag = 'nodeSM' + key
                stream = {'network': 'tcp', 'sockopt': {'mark': 255, 'tcpFastOpen': True, 'tcpNoDelay': True}}
                if node.get('path'):
                    tls = node.get('tls') or host
                    stream.update(network='ws', security='tls', wsSettings={'path': node['path'], 'headers': {'Host': tls}},
                                  tlsSettings={'serverName': tls, 'allowInsecure': False})
                config['outbounds'].append({'tag': tag, 'protocol': 'vmess',
                    'settings': {'vnext': [{'address': host, 'port': port, 'users': [{'id': node['uuid'], 'alterId': 0, 'security': 'auto'}]}]},
                    'streamSettings': stream,
                    'mux': {'enabled': True, 'concurrency': 1, 'xudpConcurrency': 1, 'xudpProxyUDP443': 'reject'}})
        preset_rules.append({'type': 'field', 'ruleTag': 'preset-' + key, 'domain': preset['domains'], 'network': 'tcp,udp', 'outboundTag': tag})
        if preset.get('ips'):
            preset_rules.append({'type': 'field', 'ruleTag': 'preset-' + key + '-ip', 'ip': preset['ips'], 'network': 'tcp,udp', 'outboundTag': tag})
    tags = {o.get('tag') for o in config['outbounds']}
    if any(rule['outboundTag'] not in tags for rule in preset_rules):
        raise ValueError('Default or direct outbound missing')
    # Local destinations keep their existing direct route; site rules precede broader proxy rules.
    private = [rule for rule in rules if rule.get('ip') == ['geoip:private'] and rule.get('outboundTag') == 'direct']
    config['routing']['rules'] = private + preset_rules + [rule for rule in rules if rule not in private]
    saved['status'] = 'on' if any(saved.get(key) for key in presets) else 'off'
    return state, config


def write_json(path, value):
    stat = path.stat()
    fd, name = tempfile.mkstemp(dir=path.parent, prefix='.preset-')
    try:
        with os.fdopen(fd, 'w') as f:
            json.dump(value, f, ensure_ascii=False, indent=2)
            f.write('\n')
        os.chown(name, stat.st_uid, stat.st_gid)
        os.chmod(name, stat.st_mode & 0o777)
        os.replace(name, path)
    finally:
        if os.path.exists(name):
            os.unlink(name)


def main():
    import fcntl
    root = Path('/opt/de_GWD')
    with (root / '.presets.lock').open('w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        state_path, config_path = root / '0conf', root / 'vtrui/config.json'
        old_state, old_config = json.loads(state_path.read_text()), json.loads(config_path.read_text())
        presets = json.loads(Path('/var/www/html/routing-presets.json').read_text())
        selections = json.loads(sys.argv[2]) if len(sys.argv) > 2 else None
        state, config = build_config(old_state, old_config, presets, selections)
        with tempfile.NamedTemporaryFile(mode='w', suffix='.json') as candidate:
            json.dump(config, candidate)
            candidate.flush()
            subprocess.run([str(root / 'vtrui/vtrui'), 'run', '-test', '-config', candidate.name], check=True)
        try:
            write_json(config_path, config)
            write_json(state_path, state)
            subprocess.run([str(root / 'ui-submitListBWsm')], check=True)
            if len(sys.argv) > 1 and sys.argv[1] == 'r':
                for service in ('mosdns', 'vtrui'):
                    subprocess.run(['systemctl', 'restart', service], check=True)
                    subprocess.run(['systemctl', 'is-active', '--quiet', service], check=True)
        except Exception:
            write_json(config_path, old_config)
            write_json(state_path, old_state)
            subprocess.run([str(root / 'ui-submitListBWsm')])
            if len(sys.argv) > 1 and sys.argv[1] == 'r':
                subprocess.run(['systemctl', 'restart', 'mosdns', 'vtrui'])
            raise


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, KeyError, subprocess.CalledProcessError):
        print('分流配置未生效，请检查节点信息和服务状态。', file=sys.stderr)
        sys.exit(1)
