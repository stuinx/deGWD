#!/bin/bash
set -u

if [[ ${1:-} == "off" ]]; then
    crontab -l 2>/dev/null > /tmp/now.cron
    sed -i '/autoUpdate/d' /tmp/now.cron
    crontab /tmp/now.cron
    rm -f /tmp/now.cron /opt/de_GWD/autoUpdate
    exit 0
fi

[[ ${1:-} =~ ^([0-9]|1[0-9]|2[0-3])$ ]] || exit 1
cat <<'EOF' >/opt/de_GWD/autoUpdate
#!/bin/bash
set -u
[[ -f /opt/de_GWD/.repo/download.env ]] && source /opt/de_GWD/.repo/download.env
GWD_REPO=${GWD_REPO:-stuinx/deGWD}
GWD_REF=${GWD_REF:-codex/install-test-20260913}
localVer=$(awk 'NR==1' /var/www/html/act/version.php)
versionURL="https://raw.githubusercontent.com/$GWD_REPO/$GWD_REF/version.php"
remoteVer=$(curl -fsSL --connect-timeout 10 --max-time 30 "$versionURL") || exit 1
remoteVer=${remoteVer%%$'\n'*}
[[ $remoteVer =~ ^v[0-9][0-9A-Za-z._-]*$ ]] || exit 1
[[ $remoteVer != "$localVer" ]] || exit 0
[[ $(printf '%s\n%s\n' "$localVer" "$remoteVer" | sort -V | tail -n 1) == "$remoteVer" ]] || exit 0
/opt/de_GWD/ui-updateSave || exit 1
exec /opt/de_GWD/update --auto-update
EOF
chmod 700 /opt/de_GWD/autoUpdate

crontab -l 2>/dev/null > /tmp/now.cron
sed -i '/autoUpdate/d' /tmp/now.cron
echo "0 $1 * * * /opt/de_GWD/autoUpdate" >> /tmp/now.cron
crontab /tmp/now.cron
rm -f /tmp/now.cron
