  if [[ -n "$DomainsApple_sha256sum" && $(checkSum /tmp/Domains.apple.txt "$DomainsApple_sha256sum") = "true" ]] || [[ -z "$DomainsApple_sha256sum" && -s /tmp/Domains.apple.txt ]]; then
