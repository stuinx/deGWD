#!/bin/bash
RED='\E[1;31m'
GREEN='\E[1;32m'
YELLOW='\E[1;33m'
BLUE='\E[1;34m'
PURPLE='\E[1;35m'
CYAN='\E[1;36m'
WHITE='\E[1;37m'
cRES='\E[0m'



/opt/de_GWD/tcpTime

if [[ -s /opt/de_GWD/.repo/geosite.dat ]] && [[ -s /opt/de_GWD/.repo/geoip.dat ]] && [[ -s /opt/de_GWD/.repo/Domains.chn.txt ]]; then
  serverConnect1=$(curl -Is -m 5 google.com | grep 'HTTP')
  serverConnect2=$(curl -Is -m 5 youtube.com | grep 'HTTP')
  [[ -z $serverConnect1 ]] && [[ -z $serverConnect2 ]] && exit
fi

[[ $1 = "u" ]] && service cron stop

echo -e "${WHITE}[...]\c" && echo -e "\t${WHITE}Update CHN Domain & IP rules${cRES}\r\c"
checkSum(){
sha256sumL=$(sha256sum $1 2>/dev/null | awk '{print$1}')
if [[ $sha256sumL = $2 ]]; then 
  echo "true"
elif [[ $sha256sumL != $2 ]]; then
  echo "false"
fi
}

get_sha256(){
  local url="$1"
  local sum
  sum=$(curl -fsSLo- "$url" 2>/dev/null | awk '{print$1}')
  if [[ -z "$sum" ]]; then
    sum=$(curl -fsSLo- "https://ghproxy.net/$url" 2>/dev/null | awk '{print$1}')
  fi
  echo "$sum"
}

geosite_sha256sum=$(get_sha256 https://raw.githubusercontent.com/Loyalsoldier/v2ray-rules-dat/release/geosite.dat.sha256sum)
geoip_sha256sum=$(get_sha256 https://raw.githubusercontent.com/Loyalsoldier/geoip/release/geoip.dat.sha256sum)
IPchnroute_sha256sum=$(get_sha256 https://raw.githubusercontent.com/jacyl4/chnroute/main/IPchnroute.sha256sum)
DomainsChn_sha256sum=$(get_sha256 https://raw.githubusercontent.com/jacyl4/chnroute/main/mosdns_chnlist/Domains.chn.txt.sha256sum)
