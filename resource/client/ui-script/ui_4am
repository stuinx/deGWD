rm -rf /tmp/99-bogus-nxdomain.china.conf
wget --show-progress -cqO /tmp/99-bogus-nxdomain.china.conf https://raw.githubusercontent.com/jacyl4/chnroute/main/mosdns_chnlist/99-bogus-nxdomain.china.conf || \
wget --show-progress -cqO /tmp/99-bogus-nxdomain.china.conf https://ghproxy.net/https://raw.githubusercontent.com/jacyl4/chnroute/main/mosdns_chnlist/99-bogus-nxdomain.china.conf
  if [[ -n "$bogusNxdomain_sha256sum" && $(checkSum /tmp/99-bogus-nxdomain.china.conf "$bogusNxdomain_sha256sum") = "true" ]] || [[ -z "$bogusNxdomain_sha256sum" && -s /tmp/99-bogus-nxdomain.china.conf ]]; then
