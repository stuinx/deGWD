if [[ -z "$geosite_sha256sum" ]] || [[ $(checkSum /opt/de_GWD/.repo/geosite.dat "$geosite_sha256sum") = "false" ]]; then
rm -rf /tmp/geosite.dat
wget --show-progress -cqO /tmp/geosite.dat https://raw.githubusercontent.com/Loyalsoldier/v2ray-rules-dat/release/geosite.dat || \
wget --show-progress -cqO /tmp/geosite.dat https://ghproxy.net/https://raw.githubusercontent.com/Loyalsoldier/v2ray-rules-dat/release/geosite.dat
  if [[ -n "$geosite_sha256sum" && $(checkSum /tmp/geosite.dat "$geosite_sha256sum") = "true" ]] || [[ -z "$geosite_sha256sum" && -s /tmp/geosite.dat ]]; then
    mv -f /tmp/geosite.dat /opt/de_GWD/.repo/geosite.dat
  else
    echo -e "${WHITE}[ ${RED}✕ ${WHITE}]\c" && echo -e "\t${WHITE}geosite.dat${RED} Download Failed${cRES}"
  fi
fi

