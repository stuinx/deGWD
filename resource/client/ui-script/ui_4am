#!/bin/bash
RED='\E[1;31m'
GREEN='\E[1;32m'
YELLOW='\E[1;33m'
BLUE='\E[1;34m'
PURPLE='\E[1;35m'
CYAN='\E[1;36m'
WHITE='\E[1;37m'
cRES='\E[0m'



/opt/de_GWD/tcpTime

serverConnect1=$(curl -Is -m 5 google.com | grep 'HTTP')
serverConnect2=$(curl -Is -m 5 youtube.com | grep 'HTTP')
[[ -z $serverConnect1 ]] && [[ -z $serverConnect2 ]] && exit

[[ $1 = "u" ]] && systemctl stop cron >/dev/null 2>&1

echo -e "${WHITE}[...]\c" && echo -e "\t${WHITE}Update CHN Domain & IP rules${cRES}\r\c"
checkSum(){
if [[ ! ${2:-} =~ ^[[:xdigit:]]{64}$ ]] || [[ ! -s $1 ]]; then
  echo "false"
  return 0
fi
sha256sumL=$(sha256sum $1 2>/dev/null | awk '{print$1}')
if [[ $sha256sumL = $2 ]]; then 
  echo "true"
elif [[ $sha256sumL != $2 ]]; then
  echo "false"
fi
}

[[ -x /opt/de_GWD/repoGet ]] || exit 1
repoGet(){ /opt/de_GWD/repoGet "$@"; }

fetchResource(){
  local dest=$1 url=$2 minKB=${3:-1} expected tmp
  expected=$(repoGet "${url}.sha256sum") || return 1
  expected=${expected%%[[:space:]]*}
  [[ $expected =~ ^[[:xdigit:]]{64}$ ]] || return 1
  if [[ $(checkSum "$dest" "$expected") = "true" ]]; then
    return 0
  fi
  tmp=$(mktemp /tmp/de-gwd-4am.XXXXXX) || return 1
  if ! repoGet "$url" >"$tmp" || [[ $(checkSum "$tmp" "$expected") != "true" ]] || [[ $(du -sk "$tmp" 2>/dev/null | awk '{print $1}') -lt $minKB ]]; then
    rm -f "$tmp"
    return 1
  fi
  mv -f "$tmp" "$dest"
}

fetchResource /opt/de_GWD/.repo/geosite.dat https://raw.githubusercontent.com/Loyalsoldier/v2ray-rules-dat/release/geosite.dat 3500 || exit 1
fetchResource /opt/de_GWD/.repo/geoip.dat https://raw.githubusercontent.com/Loyalsoldier/geoip/release/geoip.dat 8000 || exit 1
fetchResource /opt/de_GWD/.repo/IPchnroute https://raw.githubusercontent.com/jacyl4/chnroute/main/IPchnroute 100 || exit 1
fetchResource /opt/de_GWD/.repo/Domains.chn.txt https://raw.githubusercontent.com/jacyl4/chnroute/main/mosdns_chnlist/Domains.chn.txt 20 || exit 1
fetchResource /opt/de_GWD/.repo/Domains.apple.txt https://raw.githubusercontent.com/jacyl4/chnroute/main/mosdns_chnlist/Domains.apple.txt 1 || exit 1
fetchResource /opt/de_GWD/.repo/Domains.games.txt https://raw.githubusercontent.com/jacyl4/chnroute/main/mosdns_chnlist/Domains.games.txt 1 || exit 1
fetchResource /opt/de_GWD/.repo/99-bogus-nxdomain.china.conf https://raw.githubusercontent.com/jacyl4/chnroute/main/mosdns_chnlist/99-bogus-nxdomain.china.conf 1 || exit 1

cp -f /opt/de_GWD/.repo/99-bogus-nxdomain.china.conf /etc/dnsmasq.d/
chmod 0644 /etc/dnsmasq.d/99-bogus-nxdomain.china.conf
cp -f /opt/de_GWD/.repo/geosite.dat /opt/de_GWD/vtrui/geosite.dat
cp -f /opt/de_GWD/.repo/geoip.dat /opt/de_GWD/vtrui/geoip.dat

if [[ -s /opt/de_GWD/.repo/IPchnroute ]]; then
cp -f /opt/de_GWD/.repo/IPchnroute /opt/de_GWD/nftables/IP_CHNROUTE
sed -i '/^\s*$/d' /opt/de_GWD/nftables/IP_CHNROUTE
sed -i 's/$/,/g' /opt/de_GWD/nftables/IP_CHNROUTE
nft flush set ip de_GWD CHNROUTE
cat << EOF >/opt/de_GWD/nftables/SET_CHNROUTE.nft
#!/usr/sbin/nft -f
table ip de_GWD {
        set CHNROUTE {
                type ipv4_addr
                flags interval
                auto-merge
                elements = { $(cat /opt/de_GWD/nftables/IP_CHNROUTE) }
        }
}
EOF
chmod +x /opt/de_GWD/nftables/SET_CHNROUTE.nft
/opt/de_GWD/nftables/SET_CHNROUTE.nft
fi

if [[ -n $(openssl x509 -enddate -noout -in /var/www/ssl/de_GWD.cer -checkend 259200 | grep "Certificate will expire") ]] && [[ -x "/root/.acme.sh/acme.sh" ]]; then
sslDomain=$(jq -r '.FORWARD.domain' /opt/de_GWD/0conf 2>/dev/null | grep -v '^null$')
if [[ -n $sslDomain ]] &&
   "/root/.acme.sh"/acme.sh --force --set-default-ca --server letsencrypt &&
   "/root/.acme.sh"/acme.sh --force --cron --home "/root/.acme.sh" &&
   "/root/.acme.sh"/acme.sh --force --installcert -d "$sslDomain" \
     --key-file /var/www/ssl/de_GWD.key \
     --fullchain-file /var/www/ssl/de_GWD.cer \
     --reloadcmd "chmod 644 /var/www/ssl/*.key && systemctl force-reload nginx" \
     --ecc; then
  chmod 644 /var/www/ssl/*.key
fi
fi

[[ $1 = "u" ]] && systemctl enable --now cron >/dev/null 2>&1

echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}Update CHN Domain & IP rules${cRES}"
